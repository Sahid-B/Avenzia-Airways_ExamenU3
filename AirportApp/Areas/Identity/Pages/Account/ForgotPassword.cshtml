@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "¿Olvidaste tu contraseña?";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow rounded-4 p-2">
                <div class="card-header bg-white text-center border-0 pt-4 pb-0">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 70px; height: 70px; background-color: rgba(126, 145, 179, 0.15);">
                        <i class="bi bi-key-fill fs-1" style="color: var(--bs-primary);"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">¿Olvidaste tu contraseña?</h3>
                    <p class="text-muted small">Ingresa tu correo electrónico para enviarte un enlace de restablecimiento.</p>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 alert alert-danger py-2 rounded-3 border-0" role="alert"></div>
                        
                        <div class="mb-4">
                            <label asp-for="Input.Email" class="form-label fw-bold text-secondary text-uppercase small" style="letter-spacing: 0.5px;">Correo Electrónico</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                                <input asp-for="Input.Email" class="form-control border-start-0 rounded-end-3" autocomplete="username" aria-required="true" placeholder="nombre@correo.com" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2.5 fw-bold shadow-sm mb-3">
                            Enviar Enlace <i class="bi bi-send-fill ms-1 small" style="font-size:0.8rem;"></i>
                        </button>
                    </form>

                    <div class="text-center mt-3">
                        <a asp-page="./Login" class="text-secondary fw-bold text-decoration-none small"><i class="bi bi-arrow-left-short fs-5 align-middle"></i> Volver a Iniciar Sesión</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
