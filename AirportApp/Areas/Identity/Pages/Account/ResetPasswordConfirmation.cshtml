@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Contraseña restablecida";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow rounded-4 p-2 text-center">
                <div class="card-header bg-white text-center border-0 pt-4 pb-0">
                    <div class="d-inline-flex align-items-center justify-content-center bg-success-light text-success rounded-circle mb-3" style="width: 70px; height: 70px; background-color: rgba(136, 187, 167, 0.15);">
                        <i class="bi bi-check-circle-fill fs-1" style="color: var(--bs-success);"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">Contraseña Restablecida</h3>
                    <p class="text-muted small">Tu contraseña ha sido actualizada con éxito.</p>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-success border-0 small py-3 rounded-3 text-start mb-4">
                        <i class="bi bi-info-circle-fill me-2 fs-5 align-middle"></i>
                        Ya puedes ingresar a la aplicación utilizando tu nueva contraseña de seguridad.
                    </div>

                    <a asp-page="./Login" class="btn btn-primary w-100 rounded-pill py-2.5 fw-bold shadow-sm">
                        Iniciar Sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
