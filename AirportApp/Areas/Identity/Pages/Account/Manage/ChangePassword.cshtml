@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Cambiar Contraseña";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h4 class="fw-bold mb-4 border-bottom pb-2">@ViewData["Title"]</h4>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row">
    <div class="col-md-8">
        <form id="change-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.OldPassword" class="form-control rounded" autocomplete="current-password" aria-required="true" placeholder="Contraseña Anterior" />
                <label asp-for="Input.OldPassword">Contraseña Anterior</label>
                <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.NewPassword" class="form-control rounded" autocomplete="new-password" aria-required="true" placeholder="Nueva Contraseña" />
                <label asp-for="Input.NewPassword">Nueva Contraseña</label>
                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            </div>
            <div class="form-floating mb-4">
                <input asp-for="Input.ConfirmPassword" class="form-control rounded" autocomplete="new-password" aria-required="true" placeholder="Confirmar Nueva Contraseña"/>
                <label asp-for="Input.ConfirmPassword">Confirmar Nueva Contraseña</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-dark rounded-pill px-4 py-2 fw-bold shadow-sm">Actualizar Contraseña</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
