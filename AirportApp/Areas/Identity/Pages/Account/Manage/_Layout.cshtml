@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout !=  null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow border-0 rounded-4">
                <div class="card-header bg-dark text-white p-4 rounded-top-4">
                    <h3 class="mb-1 fw-bold"><i class="bi bi-gear-fill me-2"></i> Configuración de Cuenta</h3>
                    <p class="mb-0 text-white-50 small">Administra tus detalles de perfil, seguridad e inicio de sesión</p>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-4 border-end pe-md-4 mb-4 mb-md-0">
                            <partial name="_ManageNav" />
                        </div>
                        <div class="col-md-8 ps-md-4">
                            @RenderBody()
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
