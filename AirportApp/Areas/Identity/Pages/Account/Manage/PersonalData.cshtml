@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h4 class="fw-bold mb-4 border-bottom pb-2">Datos Personales</h4>

<div class="row">
    <div class="col-md-8">
        <p class="text-muted">Tu cuenta contiene datos personales que nos has proporcionado. Esta página te permite descargar o eliminar de forma permanente esos datos.</p>
        
        <div class="alert alert-danger rounded shadow-sm d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
            <div>
                <strong>¡Eliminar estos datos borrará de forma permanente tu cuenta, y esta acción no se puede deshacer!</strong>
            </div>
        </div>

        <div class="d-flex gap-3">
            <form id="download-data" asp-page="DownloadPersonalData" method="post">
                <button class="btn btn-outline-dark rounded-pill px-4 fw-bold shadow-sm" type="submit">
                    <i class="bi bi-download"></i> Descargar Datos
                </button>
            </form>
            <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">
                <i class="bi bi-trash-fill"></i> Eliminar Cuenta
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
