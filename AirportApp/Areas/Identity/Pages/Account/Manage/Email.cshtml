@page
@model EmailModel
@{
    ViewData["Title"] = "Administrador de Correo";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<h4 class="fw-bold mb-4 border-bottom pb-2">@ViewData["Title"]</h4>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row">
    <div class="col-md-8">
        <form id="email-form" method="post">
            <div asp-validation-summary="All" class="text-danger small" role="alert"></div>
            @if (Model.IsEmailConfirmed)
            {
                <div class="form-floating mb-3 input-group">
                    <input asp-for="Email" class="form-control rounded-start bg-light" placeholder="Correo Actual" disabled />
                    <span class="input-group-text bg-success text-white border-0"><i class="bi bi-check-circle-fill"></i></span>
                    <label asp-for="Email"></label>
                </div>
            }
            else
            {
                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control rounded bg-light" placeholder="Correo Actual" disabled />
                    <label asp-for="Email"></label>
                    <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link text-decoration-none small p-0 mt-1">Enviar correo de verificación</button>
                </div>
            }
            <div class="form-floating mb-4">
                <input asp-for="Input.NewEmail" class="form-control rounded" autocomplete="email" aria-required="true" placeholder="Nuevo Correo" />
                <label asp-for="Input.NewEmail"></label>
                <span asp-validation-for="Input.NewEmail" class="text-danger small"></span>
            </div>
            <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-dark rounded-pill px-4 py-2 fw-bold shadow-sm">Cambiar Correo</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
