@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow rounded-4 p-2">
                <div class="card-header bg-white text-center border-0 pt-4 pb-0">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 70px; height: 70px; background-color: rgba(126, 145, 179, 0.15);">
                        <i class="bi bi-shield-lock-fill fs-1" style="color: var(--bs-primary);"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">Nueva Contraseña</h3>
                    <p class="text-muted small">Crea una nueva contraseña segura para tu cuenta de Avenzia Airways.</p>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 alert alert-danger py-2 rounded-3 border-0" role="alert"></div>
                        <input asp-for="Input.Code" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label fw-bold text-secondary text-uppercase small" style="letter-spacing: 0.5px;">Correo Electrónico</label>
                            <input asp-for="Input.Email" class="form-control rounded-3" autocomplete="username" aria-required="true" placeholder="nombre@correo.com" />
                            <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label fw-bold text-secondary text-uppercase small" style="letter-spacing: 0.5px;">Nueva Contraseña</label>
                            <input asp-for="Input.Password" class="form-control rounded-3" autocomplete="new-password" aria-required="true" placeholder="Mínimo 6 caracteres" />
                            <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.ConfirmPassword" class="form-label fw-bold text-secondary text-uppercase small" style="letter-spacing: 0.5px;">Confirmar Contraseña</label>
                            <input asp-for="Input.ConfirmPassword" class="form-control rounded-3" autocomplete="new-password" aria-required="true" placeholder="Repite tu contraseña" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2.5 fw-bold shadow-sm mb-3">
                            Restablecer Contraseña
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
