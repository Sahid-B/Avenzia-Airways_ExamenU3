<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Avenzia Airways</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AirportApp.styles.css" asp-append-version="true" />
    @if (!User.IsInRole("Administrador"))
    {
        <style>
            a[href*="/Create"], a[href*="/Edit"], a[href*="/Delete"],
            button[formaction*="/Create"], button[formaction*="/Edit"], button[formaction*="/Delete"],
            input[formaction*="/Create"], input[formaction*="/Edit"], input[formaction*="/Delete"] {
                display: none !important;
            }
        </style>
    }
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom shadow-sm mb-4 py-2">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="/img/logo1.png" alt="Avenzia Airways Logo" style="height: 40px; width: auto;" class="me-2 bg-white p-1 rounded" />
                    <span class="fw-bold text-white" style="letter-spacing: 0.5px;">Avenzia Airways</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white-50" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door-fill"></i> Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" asp-area="" asp-controller="Home" asp-action="Privacy"><i class="bi bi-shield-fill"></i> Privacidad</a>
                        </li>
                        
                        @if (User.IsInRole("Administrador"))
                        {
                            <!-- 1. Selector de Administración (CRUDs) -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white-50" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-shield-lock-fill"></i> Administración
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark shadow border-0" aria-labelledby="adminDropdown">
                                    <li><a class="dropdown-item" asp-controller="AirportsData" asp-action="Index"><i class="bi bi-airplane-engines me-2"></i> Aeropuertos</a></li>
                                    <li><a class="dropdown-item" asp-controller="Bookings" asp-action="Index"><i class="bi bi-journal-text me-2"></i> Reservas</a></li>
                                    <li><a class="dropdown-item" asp-controller="Flights" asp-action="Index"><i class="bi bi-calendar-event me-2"></i> Vuelos</a></li>
                                    <li><a class="dropdown-item" asp-controller="Tickets" asp-action="Index"><i class="bi bi-ticket-perforated me-2"></i> Boletos</a></li>
                                    <li><a class="dropdown-item" asp-controller="TicketFlights" asp-action="Index"><i class="bi bi-ticket-detailed me-2"></i> Vuelos de Boletos</a></li>
                                    <li><hr class="dropdown-divider bg-secondary"></li>
                                    <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index"><i class="bi bi-receipt me-2"></i> Órdenes</a></li>
                                    <li><a class="dropdown-item" asp-controller="OrderDetails" asp-action="Index"><i class="bi bi-list-check me-2"></i> Detalles de Órdenes</a></li>
                                    <li><a class="dropdown-item" asp-controller="Payments" asp-action="Index"><i class="bi bi-credit-card me-2"></i> Pagos</a></li>
                                    <li><hr class="dropdown-divider bg-secondary"></li>
                                    <li><a class="dropdown-item" asp-controller="FlightChangeRequests" asp-action="Index"><i class="bi bi-pencil-square me-2"></i> Solicitudes de Cambio</a></li>
                                    <li><a class="dropdown-item" asp-controller="FlightChangeHistories" asp-action="Index"><i class="bi bi-clock-history me-2"></i> Historial de Cambios</a></li>
                                </ul>
                            </li>
                            
                            <!-- 2. Reportes (LINQ Queries) -->
                            <li class="nav-item">
                                <a class="nav-link fw-bold text-primary" asp-area="" asp-controller="LinqQueries" asp-action="Index">
                                    <i class="bi bi-bar-chart-line-fill"></i> Reportes
                                </a>
                            </li>
                        }

                        <!-- 3. Comprar Vuelos -->
                        <li class="nav-item">
                            <a class="nav-link fw-bold text-success" asp-area="" asp-controller="Shopping" asp-action="Index"><i class="bi bi-cart-fill"></i> Comprar Vuelos</a>
                        </li>

                        <!-- 4. Reprogramar Vuelo -->
                        <li class="nav-item ms-lg-2">
                            <a class="nav-link fw-bold text-danger" asp-area="" asp-controller="FlightReprogramming" asp-action="Index"><i class="bi bi-calendar2-range"></i> Reprogramar Vuelo</a>
                        </li>

                        <!-- 5. Upgrade Asiento -->
                        <li class="nav-item ms-lg-2">
                            <a class="nav-link fw-bold text-warning" asp-area="" asp-controller="SeatUpgrade" asp-action="Index"><i class="bi bi-star-fill text-warning me-1"></i> Upgrade Asiento</a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- 6. Mis Órdenes -->
                            <li class="nav-item ms-lg-2">
                                <a class="nav-link fw-bold text-info" asp-area="" asp-controller="Orders" asp-action="Index"><i class="bi bi-journal-text me-1"></i> Mis Órdenes</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - AirportApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
