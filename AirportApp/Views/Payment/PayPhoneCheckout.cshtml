@model AirportApp.Models.Payment

@{
    ViewData["Title"] = "Pago con PayPhone";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h4 class="mb-0">Pago con PayPhone</h4>
                </div>
                <div class="card-body p-4 text-center">
                    <h2 class="text-success fw-bold mb-3">@Model.Amount.ToString("C")</h2>
                    <p class="text-muted">Orden de Reprogramación: <strong>#@Model.OrderId</strong></p>
                    <p class="text-muted">Transacción Cliente ID: <span class="font-monospace">@Model.ExternalTransactionId</span></p>

                    <div class="alert alert-info py-3 text-start small mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-info-circle-fill flex-shrink-0 me-2" viewBox="0 0 16 16">
                            <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287z"/>
                        </svg>
                        Esta vista utiliza la pasarela **PayPhone** en ambiente de pruebas (Ecuador). Al presionar el botón de abajo se abrirá la pasarela Sandbox externa de PayPhone para ingresar su número y tarjeta de pruebas.
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.ResponseMessage))
                    {
                        <div class="d-grid mb-3">
                            <a href="@Model.ResponseMessage" target="_blank" class="btn btn-success btn-lg">
                                Abrir Link de Pago PayPhone (Sandbox)
                            </a>
                        </div>
                    }

                    <hr class="my-4" />

                    <!-- Simulación de Éxito ya que localhost no recibe webhooks públicos -->
                    <div class="bg-light p-3 rounded mb-2">
                        <p class="text-secondary small mb-3">Dado que la aplicación se ejecuta localmente (localhost), el webhook de PayPhone no puede conectarse a tu máquina para confirmar el pago automáticamente. Usa este botón para simular la confirmación del pago.</p>
                        <form asp-action="ConfirmPayPhone" method="post">
                            <input type="hidden" name="paymentId" value="@Model.PaymentId" />
                            <button type="submit" class="btn btn-warning w-100">
                                Simular Pago Exitoso (Confirmar en DB)
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
