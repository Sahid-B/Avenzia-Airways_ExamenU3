@model AirportApp.Models.Payment

@{
    var desc = Model.Order?.OrderDetails?.FirstOrDefault()?.Description ?? "";
    string title = "Comprobante de Transacción";
    string alertHeader = "¡Pago Confirmado!";
    string alertSub = "Su pago ha sido verificado con éxito en el sistema.";
    string totalLabel = "Total pagado:";

    if (desc.Contains("Reprogramación"))
    {
        title = "Comprobante de Reprogramación";
        alertHeader = "¡Reprogramación Confirmada!";
        alertSub = "Su pago ha sido verificado con éxito y el vuelo ha sido reprogramado.";
        totalLabel = "Total adicional pagado:";
    }
    else if (desc.Contains("Upgrade"))
    {
        title = "Comprobante de Upgrade";
        alertHeader = "¡Upgrade de Asiento Confirmado!";
        alertSub = "Su pago ha sido verificado con éxito y su asiento ha sido mejorado a clase Business.";
        totalLabel = "Total pagado:";
    }
    else
    {
        title = "Comprobante de Compra de Vuelo";
        alertHeader = "¡Compra de Vuelo Confirmada!";
        alertSub = "Su pago ha sido verificado con éxito y su boleto ha sido generado.";
        totalLabel = "Total pagado:";
    }
    
    ViewData["Title"] = title;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <!-- Alerta Éxito -->
            <div class="alert alert-success d-flex align-items-center mb-4 shadow-sm" role="alert">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-check-circle-fill flex-shrink-0 me-2" viewBox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                </svg>
                <div>
                    <h5 class="alert-heading mb-1">@alertHeader</h5>
                    @alertSub
                </div>
            </div>

            <!-- Detalle de Transacción -->
            <div class="card border-0 shadow mb-4">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h4 class="mb-0">Comprobante de Transacción</h4>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-3">
                        <div class="col-sm-6">
                            <span class="text-muted">Orden de Compra:</span>
                            <p class="h6">#@Model.OrderId</p>
                        </div>
                        <div class="col-sm-6 text-sm-end">
                            <span class="text-muted">Referencia de Reserva:</span>
                            <p class="h6">@Model.Order?.BookRef</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-6">
                            <span class="text-muted">ID Transacción PayPal:</span>
                            <p class="h6 font-monospace text-primary">@Model.ExternalTransactionId</p>
                        </div>
                        <div class="col-sm-6 text-sm-end">
                            <span class="text-muted">Estado del Pago:</span>
                            <p class="h6"><span class="badge bg-success">@Model.Status</span></p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-6">
                            <span class="text-muted">Fecha Confirmación:</span>
                            <p class="h6">@Model.ConfirmationDate?.ToString("dd/MM/yyyy HH:mm:ss")</p>
                        </div>
                        <div class="col-sm-6 text-sm-end">
                            <span class="text-muted">Pasarela / Gateway:</span>
                            <p class="h6">@Model.Gateway</p>
                        </div>
                    </div>

                    <hr />

                    <h5 class="text-secondary mt-4 mb-3">Resumen de Cargos</h5>
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Descripción</th>
                                    <th class="text-end" style="width: 150px;">Monto</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Order?.OrderDetails != null)
                                {
                                    foreach (var d in Model.Order.OrderDetails)
                                    {
                                        <tr>
                                            <td>@d.Description</td>
                                            <td class="text-end">@d.Amount.ToString("C")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th class="text-end">@totalLabel</th>
                                    <th class="text-end text-success fs-5">@Model.Amount.ToString("C")</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Botones -->
            <div class="text-center mb-5">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg shadow-sm px-5">
                    Volver a Inicio
                </a>
            </div>
        </div>
    </div>
</div>
