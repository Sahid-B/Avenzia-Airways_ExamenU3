@model AirportApp.Models.Order

@{
    ViewData["Title"] = "Comprobante de Upgrade";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-success text-white text-center rounded-top-4 py-4">
                    <h3 class="mb-0 fw-bold"><i class="bi bi-check-circle-fill"></i> ¡Upgrade Exitoso!</h3>
                    <p class="mb-0">Tu asiento ha sido mejorado a clase Business</p>
                </div>
                <div class="card-body p-5">
                    
                    <div class="alert alert-light border shadow-sm mb-4">
                        <div class="row">
                            <div class="col-sm-6 border-end">
                                <p class="text-muted small mb-1">Orden #</p>
                                <p class="fw-bold fs-5 mb-0">@Model.OrderId</p>
                            </div>
                            <div class="col-sm-6 ps-4">
                                <p class="text-muted small mb-1">Reserva Original</p>
                                <p class="fw-bold fs-5 mb-0 text-primary">@Model.BookRef</p>
                            </div>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3 border-bottom pb-2">Detalles del Cargo</h5>
                    
                    <ul class="list-group mb-4">
                        @foreach(var detail in Model.OrderDetails)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                                @detail.Description
                                <span>$@detail.Amount.ToString("F2")</span>
                            </li>
                        }
                    </ul>
                    
                    <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded border mb-4">
                        <span class="fw-bold fs-5">Total Pagado</span>
                        <span class="fw-bold fs-4 text-success">$@Model.TotalAmount.ToString("F2")</span>
                    </div>

                    <div class="text-center mt-5">
                        <p class="text-muted">¡Gracias por preferir viajar con mayor comodidad!</p>
                        <a asp-controller="SeatUpgrade" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">Volver al Inicio</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
