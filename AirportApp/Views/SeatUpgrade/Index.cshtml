@{
    ViewData["Title"] = "Upgrade de Asiento";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center rounded-top-4 py-3">
                    <h3 class="mb-0"><i class="bi bi-star-fill text-warning"></i> Upgrade de Cabina</h3>
                    <p class="mb-0 small text-white-50">Sube a clase Business y disfruta del viaje</p>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["Error"]
                        </div>
                    }

                    <form asp-action="Search" method="post">
                        <div class="mb-4">
                            <label for="bookRef" class="form-label fw-bold">Código de Reserva (BookRef)</label>
                            <input type="text" class="form-control form-control-lg text-uppercase" id="bookRef" name="bookRef" placeholder="Ej. 00000F" required maxlength="6">
                            <div class="form-text">Ingresa el código de 6 caracteres de tu reserva.</div>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill">
                                <i class="bi bi-search"></i> Buscar mis Boletos
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
