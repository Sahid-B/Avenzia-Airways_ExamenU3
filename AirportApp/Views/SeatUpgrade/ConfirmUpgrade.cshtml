@model AirportApp.Models.TicketFlight

@{
    ViewData["Title"] = "Confirmar Upgrade";
    var ticketNo = ViewData["TicketNo"]?.ToString();
    var flightId = ViewData["FlightId"]?.ToString();
    var currentFare = ViewData["CurrentFare"]?.ToString();
    var upgradeCost = (decimal)ViewData["UpgradeCost"];
    var bookRef = ViewData["BookRef"]?.ToString();
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning text-dark text-center rounded-top-4 py-4">
                    <h3 class="mb-0 fw-bold"><i class="bi bi-star"></i> Upgrade a Cabina Business</h3>
                    <p class="mb-0">Estás a un paso de viajar con la mayor comodidad</p>
                </div>
                <div class="card-body p-5">
                    
                    <h5 class="fw-bold mb-4 border-bottom pb-2">Resumen de tu selección</h5>
                    <div class="row mb-4">
                        <div class="col-sm-6">
                            <p class="mb-1 text-muted">Boleto:</p>
                            <p class="fw-bold fs-5">@ticketNo</p>
                        </div>
                        <div class="col-sm-6">
                            <p class="mb-1 text-muted">Vuelo:</p>
                            <p class="fw-bold fs-5">@flightId</p>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded mb-4 border">
                        <div>
                            <span class="d-block text-muted small">Clase Actual</span>
                            <span class="badge bg-secondary fs-6">@currentFare</span>
                        </div>
                        <div><i class="bi bi-arrow-right fs-3 text-muted"></i></div>
                        <div class="text-end">
                            <span class="d-block text-muted small">Nueva Clase</span>
                            <span class="badge bg-warning text-dark fs-6">Business</span>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3 border-bottom pb-2">Desglose de Pago</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Costo de Upgrade a Business</span>
                        <span>$@upgradeCost.ToString("F2")</span>
                    </div>
                    
                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fw-bold fs-4">Total a Pagar</span>
                        <span class="fw-bold fs-3 text-success">$@upgradeCost.ToString("F2")</span>
                    </div>

                    <form asp-action="CreateOrder" method="post">
                        <input type="hidden" name="ticketNo" value="@ticketNo" />
                        <input type="hidden" name="flightId" value="@flightId" />
                        <input type="hidden" name="upgradeCost" value="@upgradeCost" />

                        <div class="d-grid gap-3 d-md-flex justify-content-md-end">
                            <a asp-action="BookingTickets" asp-route-bookRef="@bookRef" class="btn btn-light rounded-pill px-4 border">Cancelar</a>
                            <button type="submit" class="btn btn-warning rounded-pill px-5 fw-bold shadow-sm">
                                <i class="bi bi-paypal"></i> Pagar y Confirmar Upgrade
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
