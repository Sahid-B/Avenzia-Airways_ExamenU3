@model PaginatedList<AirportApp.Models.FlightChangeHistory>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

@if (User.IsInRole("Administrador"))
{
    <p>
        <a asp-action="Create">Create New</a>
    </p>
}

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group w-50">
        <input type="text" name="SearchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Buscar..." />
        <input type="hidden" name="pageSize" value="@ViewData["PageSize"]" />
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParm"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-pageSize="@ViewData["PageSize"]">ChangeDate</a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["ReasonSortParm"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-pageSize="@ViewData["PageSize"]">Reason</a>
            </th>
            <th>
                BookRefNavigation
            </th>
            <th>
                NewFlight
            </th>
            <th>
                OldFlight
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ChangeDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Reason)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BookRefNavigation.BookRef)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NewFlight.FlightId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OldFlight.FlightId)
            </td>
            <td>
                @if (User.IsInRole("Administrador"))
                {
                    <a asp-action="Edit" asp-route-id="@item.ChangeId">Edit</a> @:|
                }
                <a asp-action="Details" asp-route-id="@item.ChangeId">Details</a>
                @if (User.IsInRole("Administrador"))
                {
                    @:| <a asp-action="Delete" asp-route-id="@item.ChangeId" class="btn rounded-pill px-3 py-1 fw-bold shadow-sm" style="background-color: rgba(232, 165, 152, 0.1) !important; color: var(--bs-danger) !important; border: 1px solid rgba(232, 165, 152, 0.3) !important; font-size: 0.8rem !important; display: inline-block !important; margin: 2px 3px !important; text-decoration: none !important;"><i class="bi bi-trash-fill me-1"></i>Eliminar</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>

<partial name="_Pagination" />
