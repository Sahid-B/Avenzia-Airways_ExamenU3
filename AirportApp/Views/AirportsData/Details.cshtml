@model AirportApp.Models.AirportsDatum

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>AirportsDatum</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AirportName)
        </dt>
        <dd class = "col-sm-10">
            @AirportApp.TranslationHelper.Get(Model.AirportName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.City)
        </dt>
        <dd class = "col-sm-10">
            @AirportApp.TranslationHelper.Get(Model.City)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Country)
        </dt>
        <dd class = "col-sm-10">
            @AirportApp.TranslationHelper.Get(Model.Country)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Coordinates)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Coordinates)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Timezone)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Timezone)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.AirportCode">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
