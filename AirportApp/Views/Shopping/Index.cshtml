@model AirportApp.Models.PaginatedList<AirportApp.Models.Timetable>

@{
    ViewData["Title"] = "Comprar Vuelos";
}

<div class="text-center mb-4">
    <h1 class="display-4 text-success fw-bold"><i class="bi bi-cart"></i> Comprar Vuelos</h1>
    <p class="lead">Busca y selecciona el vuelo que deseas comprar.</p>
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover table-striped align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>Vuelo No.</th>
                <th>Origen</th>
                <th>Destino</th>
                <th>Salida Programada</th>
                <th>Llegada Programada</th>
                <th>Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.RouteNo</td>
                        <td>@item.DepartureAirport</td>
                        <td>@item.ArrivalAirport</td>
                        <td>@(item.ScheduledDeparture?.ToString("dd MMM yyyy, HH:mm"))</td>
                        <td>@(item.ScheduledArrival?.ToString("dd MMM yyyy, HH:mm"))</td>
                        <td><span class="badge bg-success">@item.Status</span></td>
                        <td class="text-center">
                            <a asp-action="SelectFlight" asp-route-id="@item.FlightId" class="btn btn-primary btn-sm rounded-pill shadow-sm">
                                <i class="bi bi-ticket"></i> Seleccionar
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No hay vuelos programados disponibles en este momento.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-4">
    <partial name="_Pagination" />
</div>
